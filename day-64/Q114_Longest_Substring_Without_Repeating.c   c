
#include <stdio.h>

int main() {
    char s[10000];
    int last[256];

    scanf("%9999s", s);

    for (int i = 0; i < 256; i++)
        last[i] = -1;

    int left = 0, maxLength = 0;

    for (int right = 0; s[right] != '\0'; right++) {
        unsigned char c = (unsigned char)s[right];

        if (last[c] >= left)
            left = last[c] + 1;

        last[c] = right;

        int length = right - left + 1;
        if (length > maxLength)
            maxLength = length;
    }

    printf("%d\n", maxLength);
    return 0;
}
